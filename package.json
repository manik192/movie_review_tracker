{
  "name": "movie-review-api",
  "version": "1.0.0",
  "description": "Movie Review Tracker REST API",
  "license": "ISC",
  "author": "Manikanta Reddy Peram",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node --env-file=.env prisma/seed.js",
    "build": "prisma generate && prisma migrate deploy && node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "7.7.0",
    "bcrypt": "6.0.0",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.8.3",
    "prisma": "7.7.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
